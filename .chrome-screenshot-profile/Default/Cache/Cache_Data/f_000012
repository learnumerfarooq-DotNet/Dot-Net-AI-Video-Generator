                [ngModel]="store.credentialValue(requirement, field)"
                (ngModelChange)="store.updateCredential(requirement, field, $event)" />
            </div>
            <em>{{ field.helpText }}</em>
          </label>
        </div>

        <p class="empty-state" *ngIf="requirement.fields.length === 0">No external credential required for this provider.</p>
      </article>
    </section>
  </ng-container>

  <section class="map-grid" *ngSwitchCase="'api-agent-map'">
