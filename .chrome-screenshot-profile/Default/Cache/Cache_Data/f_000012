    </article>
    <article>
      <span>Video Agent</span>
      <strong>{{ store.providers().videoProvider }}</strong>
    </article>
    <article>
      <span>Upload Agent</span>
      <strong>{{ store.providers().uploadProvider }}</strong>
    </article>
  </section>

  <section class="content-grid single" *ngSwitchCase="'api-status'">
    <section class="panel">
      <div class="panel-heading">
        <h2>API Status</h2>
        <span>Clean Architecture API</span>
      </div>
