          <i class="fa-solid fa-floppy-disk"></i>
          <span>{{ store.savingProviders() ? 'Saving...' : 'Save APIs' }}</span>
        </button>
      </div>

      <div class="api-grid">
        <label class="field-card">
          <span class="field-title"><i class="fa-solid fa-brain"></i><span>Brain / Text API</span></span>
          <div class="select-shell">
            <select [ngModel]="store.providers().textProvider" (ngModelChange)="store.updateProviderField('textProvider', $event)">
              <option *ngFor="let option of providerOptions.textProvider" [value]="option">{{ option }}</option>
            </select>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
        </label>

        <label class="field-card">
          <span class="field-title"><i class="fa-solid fa-film"></i><span>Video API</span></span>
          <div class="select-shell">
            <select [ngModel]="store.providers().videoProvider" (ngModelChange)="store.updateProviderField('videoProvider', $event)">
              <option *ngFor="let option of providerOptions.videoProvider" [value]="option">{{ option }}</option>
            </select>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
        </label>

        <label class="field-card">
          <span class="field-title"><i class="fa-solid fa-upload"></i><span>Upload API</span></span>
          <div class="select-shell">
            <select [ngModel]="store.providers().uploadProvider" (ngModelChange)="store.updateProviderField('uploadProvider', $event)">
              <option *ngFor="let option of providerOptions.uploadProvider" [value]="option">{{ option }}</option>
            </select>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
        </label>

        <label class="field-card">
          <span class="field-title"><i class="fa-solid fa-database"></i><span>Storage API</span></span>
          <div class="select-shell">
            <select [ngModel]="store.providers().storageProvider" (ngModelChange)="store.updateProviderField('storageProvider', $event)">
              <option *ngFor="let option of providerOptions.storageProvider" [value]="option">{{ option }}</option>
            </select>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
        </label>
      </div>
    </section>

    <section class="provider-requirements">
      <article class="panel requirement-card" *ngFor="let requirement of store.selectedRequirements()">
        <div class="panel-heading">
          <div>
            <h2>{{ requirement.displayName }}</h2>
            <span>{{ requirement.providerType }}</span>
          </div>
          <a *ngIf="requirement.documentationUrl" [href]="requirement.documentationUrl" target="_blank" rel="noreferrer">Docs</a>
        </div>

        <p class="requirement-note">{{ requirement.notes }}</p>

        <div class="credential-grid" *ngIf="requirement.fields.length > 0">
          <label *ngFor="let field of requirement.fields">
            <span>
              {{ field.label }}
              <small *ngIf="store.isCredentialSaved(requirement, field)">Saved</small>
            </span>
            <div class="input-shell">
              <i class="fa-solid" [class.fa-key]="field.inputType === 'password'" [class.fa-link]="field.inputType !== 'password'"></i>
              <input
