{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ai_content_factory;Username=postgres;Password=1245"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContentFactory": {
    "TextProvider": "Template",
    "VideoProvider": "Manual",
    "UploadProvider": "DryRun",
    "StorageProvider": "LocalJson",
    "DataPath": "data"
  },
  "FFmpeg": {
    "FFmpegPath": "ffmpeg",
    "FFprobePath": "ffprobe",
    "MaxConcurrentJobs": 4,
    "TempStoragePath": "temp/videofactory",
    "MaxTempStorageBytes": 193273528320,
    "UseHardwareAcceleration": true
  },
  "Processing": {
    "MaxConcurrentFFmpegJobs": 4,
    "ProcessLocally": true,
    "UploadFinalOnly": true,
    "VpsTempGb": 200,
    "CleanupAfterHours": 24
  },
  "Storage": {
    "DrivePermanentTb": 5,
    "RawFolderPath": "/RAW",
    "ProcessedFolderPath": "/Processed",
    "ShortsRawPath": "/Shorts/raw",
    "ShortsProcessedPath": "/Shorts/processed",
    "ReadyToUploadPath": "/ReadyToUpload",
    "ErrorsPath": "/Errors/retry",
    "LogsPath": "/Logs/analytics"
  },
  "Pipeline": {
    "RawPollIntervalSeconds": 30,
    "MaxRetryCount": 3,
    "RetryBackoffSeconds": [ 30, 120, 300 ],
    "CircuitBreakerThreshold": 3,
    "CircuitBreakerPauseMinutes": 10
  },
  "Publishing": {
    "YouTube": {
      "Enabled": true,
      "StreamFromDrive": true
    },
    "TikTok": {
      "Enabled": true,
      "DownloadUploadDelete": true
    },
    "Instagram": {
      "Enabled": true,
      "DownloadUploadDelete": true
    },
    "Facebook": {
      "Enabled": true,
      "DownloadUploadDelete": true
    },
    "LinkedIn": {
      "Enabled": true,
      "DownloadUploadDelete": true
    }
  },
  "OpenRouter": {
    "ApiKey": "your-openrouter-key",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "DefaultModel": "meta-llama/llama-4-maverick:free",
    "MaxRetries": 3,
    "TimeoutSeconds": 120
  },
  "DecisionEngine": {
    "CacheTTLMinutes": 60,
    "MinConfidenceScore": 0.3,
    "MaxValidationAttempts": 2,
    "AutoRejectOnLowConfidence": true
  },
  "Shorts": {
    "MaxDurationSeconds": 60,
    "TargetAspectRatio": "9:16",
    "TargetWidth": 1080,
    "TargetHeight": 1920,
    "MinConfidenceScore": 0.3,
    "MaxShortsPerVideo": 5
  },
  "Trends": {
    "RunCronExpression": "0 0 * * * ?",
    "Tier1Sites": [ "youtube.com", "tiktok.com", "trends.google.com" ],
    "Tier2Sites": [ "bbc.com", "cnn.com", "techcrunch.com" ],
    "Tier3Sites": [ "buzzfeed.com", "mashable.com" ],
    "UseOpenRouterFallback": true,
    "MaxSitesToCheck": 50,
    "PeakSlotsUtc": [ "08:00", "12:00", "18:00", "21:00" ]
  },
  "ErrorHandling": {
    "MaxRetries": 3,
    "RetryBackoffSeconds": [ 30, 120, 300 ],
    "CircuitBreakerThreshold": 3,
    "CircuitBreakerPauseMinutes": 10,
    "FailureAlertThreshold": 5,
    "DeadLetterAfterRetries": true
  },
  "Brain": {
    "TickIntervalSeconds": 30,
    "GlobalMemorySyncIntervalSeconds": 60,
    "MaxConcurrentDispatches": 4,
    "MaxRetryPerJob": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerPauseMinutes": 10,
    "AutoDispatchOnRawDetected": true,
    "EmitSignalREvents": true,
    "GlobalMemoryDrivePath": "/memory/global.json",
    "PeakUploadSlotsUtc": ["08:00", "12:00", "18:00", "21:00"]
  },
  "AllowedHosts": "*"
}
